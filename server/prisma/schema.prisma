generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id        String   @id @default(uuid())
  title     String
  company   String
  status    String   @default("Applied")
  salary    String?
  createdAt DateTime @default(now())
}